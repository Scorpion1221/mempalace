{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "./hooks/mempal-hook.sh session-start",
        "type": "command",
        "timeout": 30
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "./hooks/mempal-hook.sh userprompt",
        "type": "command",
        "timeout": 30
      }
    ],
    "stop": [
      {
        "command": "./hooks/mempal-hook.sh stop",
        "type": "command",
        "timeout": 30
      }
    ],
    "preCompact": [
      {
        "command": "./hooks/mempal-hook.sh precompact",
        "type": "command",
        "timeout": 30
      }
    ]
  }
}
