# ~/.mempalace/env — single source of truth for all mempalace agent env vars.
#
# This file is sourced by scripts/sync-plugins.sh which propagates the values
# into every agent's native config format:
#   - Claude Code:  ~/.claude/settings.json          → env block
#   - Codex:        ~/.codex/config.toml             → [mcp_servers.mempalace].env
#                                                    + [shell_environment_policy.set]
#   - Hermes:       ~/Library/LaunchAgents/ai.hermes.gateway.plist
#                                                    → <key>EnvironmentVariables</key>
#   - Cursor:       launchctl setenv + ai.mempalace.env.plist (for macOS GUI)
#   - Shell:        ~/.zshenv sources this file (for any terminal-launched agent)
#
# Edit here, then: bash ~/git/mempalace/scripts/sync-plugins.sh
#
# The defaults assume a local LiteLLM proxy on 127.0.0.1:4000. See
# INSTALL.md → "Environment Variables" for the LiteLLM setup.

# --- Embedding (ChromaDB vectorization) ---
# All three REQUIRED when any is set. Missing any → ChromaDB falls back to
# built-in MiniLM (384 dims) and silently breaks every upsert against a
# palace created with Gemini (3072 dims). See CHANGELOG.md for the history.
export MEMPAL_EMBEDDING_MODEL="gemini-embedding-2-preview"
export MEMPAL_EMBEDDING_ENDPOINT="http://127.0.0.1:4000"
export MEMPAL_EMBEDDING_KEY="sk-litellm-local"

# --- LLM endpoint (shared by async-save + recall enhancement) ---
# One LLM, two jobs: extracting drawer/diary/KG/tunnels in the Stop hook
# AND rewriting/reranking queries in UserPromptSubmit. Default-on whenever
# endpoint+model are set; missing endpoint→ async save silently skips and
# recall falls back to raw vector search. To force off: MEMPAL_LLM=0.
export MEMPAL_LLM_ENDPOINT="http://127.0.0.1:4000/v1"
export MEMPAL_LLM_MODEL="gemini-3.1-flash-lite-preview"
export MEMPAL_LLM_KEY="sk-litellm-local"

# Legacy aliases (still read by recall_llm.py for backward compat) —
# safe to leave commented unless you want to override the canonical
# values above without changing them.
# export MEMPAL_RECALL_ENDPOINT="http://127.0.0.1:4000/v1"
# export MEMPAL_RECALL_MODEL="gemini-3.1-flash-lite-preview"
# export MEMPAL_RECALL_KEY="sk-litellm-local"

# --- Platform-specific (optional) ---
# macOS: LiteLLM's HTTPS egress needs a CA bundle path on some installs.
export SSL_CERT_FILE="${SSL_CERT_FILE:-/opt/homebrew/etc/openssl@3/cert.pem}"
