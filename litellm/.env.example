# LiteLLM Proxy Environment Variables
#
# Copy this to .env and fill in ONE of the two backends below.

# ─── (A) Gemini API backend (default) ────────────────────────────────────
# Simplest path. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ─── (B) GCP Vertex AI backend (optional) ────────────────────────────────
# Uncomment these AND switch model entries in config.yaml from gemini/* to
# vertex_ai/*. Auth uses either the mounted gcloud ADC (default) or
# GOOGLE_APPLICATION_CREDENTIALS pointing at a service-account JSON.
#
# VERTEXAI_PROJECT=your-gcp-project-id
# VERTEXAI_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/sa-key.json
